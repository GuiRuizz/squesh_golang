# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=squesh_db
DB_PORT=5432

# Configurações de Autenticação JWT
JWT_SECRET=seu_segredo_jwt_aqui

# Tempo de vida do token de acesso (ex: 15m, 1h, 24h)
ACCESS_TOKEN_EXPIRES=24h

# Tempo de vida do refresh token — mantém o usuário logado mesmo com o App fechado (ex: 720h = 30 dias)
REFRESH_TOKEN_EXPIRES=720h

# Porta da Aplicação
PORT=8080