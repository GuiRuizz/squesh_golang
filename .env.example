# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=squesh_db
DB_PORT=5432

# Configurações de Autenticação JWT
JWT_SECRET=seu_segredo_jwt_aqui

# Tempo de vida do token de acesso (ex: 15m, 1h, 24h)
ACCESS_TOKEN_EXPIRES=24h

# Tempo de vida do refresh token — mantém o usuário logado mesmo com o App fechado (ex: 720h = 30 dias)
REFRESH_TOKEN_EXPIRES=720h

# Storage de arquivos (fluxo de URL assinada / presigned)
# local = a própria API recebe o upload num diretório (setup inicial)
# s3    = futuramente aponta direto para um bucket (Sem implementação ainda)
STORAGE_DRIVER=local

# URL pública de onde o App acessa os arquivos (use o endereço externo da API em produção)
STORAGE_PUBLIC_BASE_URL=http://localhost:8080

# Diretório onde os arquivos são salvos no driver local
UPLOAD_DIR=uploads

# Opcional: segredo usado nas assinaturas de upload (padrão: usa o JWT_SECRET)
# STORAGE_SECRET=

# ---- Stripe (pagamento de planos e produtos) ----
# Sem STRIPE_SECRET_KEY a loja e a vitrine de planos continuam funcionando: só
# as rotas de cobrança respondem 503. Dá para rodar o app inteiro sem conta
# Stripe.
#
# Chave secreta: em https://dashboard.stripe.com/test/apikeys ("Chave secreta").
# NUNCA va para o app: ela concede acesso à conta.
STRIPE_SECRET_KEY=

# Chave publicável: a mesma tela, "Chave publicável". Esta SAI no app (o
# formulário de cartão é montado com ela). Por isso o servidor a entrega em
# GET /api/v1/payments/config em vez de ficar no .env do Flutter — trocar de
# conta depois não exige rebuild do app.
STRIPE_PUBLISHABLE_KEY=

# Segredo do webhook: em https://dashboard.stripe.com/test/webhooks, clique no
# endpoint e copie "Signing secret". É o que prova que o POST é da Stripe e
# não de alguém fingindo ser.
STRIPE_WEBHOOK_SECRET=

# Moeda da cobrança (padrão: brl)
STRIPE_CURRENCY=brl

# Porta da Aplicação
PORT=8080